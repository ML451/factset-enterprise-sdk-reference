    "expressions": [
      {
        "name": "FactSet_AccessToken",
        "kind": "m",
        "expression": [
          "let",
          "    // Configure your FactSet OAuth 2.0 credentials below.",
          "    // Obtain from: https://developer.factset.com/applications",
          "    clientId = \"YOUR_CLIENT_ID\",",
          "    clientSecret = \"YOUR_CLIENT_SECRET\",",
          "    tokenUrl = \"https://auth.factset.com/as/token.oauth2\",",
          "    body = \"grant_type=client_credentials&client_id=\" & clientId & \"&client_secret=\" & clientSecret,",
          "    response = Web.Contents(tokenUrl, [",
          "        Headers = [#\"Content-Type\" = \"application/x-www-form-urlencoded\"],",
          "        Content = Text.ToBinary(body)",
          "    ]),",
          "    parsed = Json.Document(response),",
          "    token = parsed[access_token]",
          "in",
          "    token"
        ],
        "lineageTag": "expr-access-token",
        "annotations": [
          { "name": "Description", "value": "FactSet OAuth 2.0 access token via client credentials flow. Replace YOUR_CLIENT_ID and YOUR_CLIENT_SECRET with values from your FactSet Developer Portal application." }
        ]
      },
      {
        "name": "FactSet_WatchlistIds",
        "kind": "m",
        "expression": [
          "let",
          "    // Define your security watchlist here. Use FactSet ticker-region format.",
          "    ids = {\"AAPL-US\", \"MSFT-US\", \"GOOGL-US\", \"AMZN-US\", \"META-US\",",
          "           \"NVDA-US\", \"TSLA-US\", \"JPM-US\", \"V-US\", \"JNJ-US\",",
          "           \"WMT-US\", \"PG-US\", \"UNH-US\", \"HD-US\", \"BAC-US\",",
          "           \"MA-US\", \"DIS-US\", \"ADBE-US\", \"CRM-US\", \"NFLX-US\"}",
          "in",
          "    ids"
        ],
        "lineageTag": "expr-watchlist",
        "annotations": [
          { "name": "Description", "value": "List of FactSet security identifiers to track. Edit this list to customize your watchlist. Format: TICKER-REGION (e.g., AAPL-US, SHEL-GB, 7203-JP)." }
        ]
      },
      {
        "name": "FactSet_BenchmarkIds",
        "kind": "m",
        "expression": [
          "let",
          "    ids = {\"SP50\"}",
          "in",
          "    ids"
        ],
        "lineageTag": "expr-benchmark-ids",
        "annotations": [
          { "name": "Description", "value": "Benchmark index identifiers. Default: SP50 (S&P 500). Other examples: R3000 (Russell 3000), MSACWI (MSCI ACWI)." }
        ]
      },
      {
        "name": "FactSet_StartDate",
        "kind": "m",
        "expression": [
          "let",
          "    startDate = \"2020-01-01\"",
          "in",
          "    startDate"
        ],
        "lineageTag": "expr-start-date",
        "annotations": [
          { "name": "Description", "value": "Start date for historical data retrieval in YYYY-MM-DD format." }
        ]
      },
      {
        "name": "FactSet_EndDate",
        "kind": "m",
        "expression": [
          "let",
          "    endDate = \"0\"",
          "in",
          "    endDate"
        ],
        "lineageTag": "expr-end-date",
        "annotations": [
          { "name": "Description", "value": "End date for data retrieval. Use '0' for current date, or specify YYYY-MM-DD format." }
        ]
      },
      {
        "name": "FactSet_FiscalStart",
        "kind": "m",
        "expression": [
          "let",
          "    period = \"-5\"",
          "in",
          "    period"
        ],
        "lineageTag": "expr-fiscal-start",
        "annotations": [
          { "name": "Description", "value": "Fiscal period start offset. -5 = five fiscal years prior to current." }
        ]
      },
      {
        "name": "FactSet_FiscalEnd",
        "kind": "m",
        "expression": [
          "let",
          "    period = \"0\"",
          "in",
          "    period"
        ],
        "lineageTag": "expr-fiscal-end",
        "annotations": [
          { "name": "Description", "value": "Fiscal period end offset. 0 = current/most recent fiscal period." }
        ]
      }
    ],
