        "partitions": [
          {
            "name": "DimBenchmark-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    apiBase = \"https://api.factset.com/content/factset-benchmarks/v1/id-list\",",
                "    requestBody = Json.FromValue([ids = FactSet_BenchmarkIds]),",
                "    response = Web.Contents(apiBase, [",
                "        Headers = [",
                "            #\"Content-Type\" = \"application/json\",",
                "            #\"Accept\" = \"application/json\",",
                "            #\"Authorization\" = \"Bearer \" & FactSet_AccessToken",
                "        ],",
                "        Content = requestBody",
                "    ]),",
                "    parsed = Json.Document(response),",
                "    data = parsed[data],",
                "    toTable = Table.FromRecords(data),",
                "    renamed = Table.RenameColumns(toTable, {",
                "        {\"fsymId\", \"BenchmarkId\"},",
                "        {\"name\", \"BenchmarkName\"},",
                "        {\"category\", \"Category\"},",
                "        {\"currency\", \"Currency\"},",
                "        {\"familyId\", \"FamilyId\"}",
                "    }, MissingField.Ignore)",
                "in",
                "    renamed"
              ]
            }
          }
        ]
      },
      {
        "name": "FactPrices",
        "description": "Daily OHLCV price data from FactSet Prices API. Split-adjusted by default.",
        "lineageTag": "fact-prices-001",
        "columns": [
          {
            "name": "FsymId",
            "dataType": "string",
            "sourceColumn": "FsymId",
            "lineageTag": "fact-prices-fsym-id",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "fact-prices-date",
            "summarizeBy": "none"
          },
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "lineageTag": "fact-prices-currency",
            "summarizeBy": "none"
          },
          {
            "name": "ClosePrice",
            "dataType": "double",
            "sourceColumn": "ClosePrice",
            "formatString": "#,##0.00",
            "lineageTag": "fact-prices-close",
            "summarizeBy": "none",
            "annotations": [
              { "name": "Format", "value": "<Format Format=\"NumberDecimal\" Accuracy=\"2\" />" }
            ]
