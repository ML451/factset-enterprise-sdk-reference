                "        {\"surpriseAmount\", \"SurpriseAmount\"},",
                "        {\"surprisePercent\", \"SurprisePercent\"},",
                "        {\"currency\", \"Currency\"}",
                "    }, MissingField.Ignore),",
                "    removeExtra = Table.RemoveColumns(renamed, {\"requestId\"}, MissingField.Ignore),",
                "    typedResult = Table.TransformColumnTypes(removeExtra, {",
                "        {\"FsymId\", type text}, {\"Date\", type date},",
                "        {\"ActualValue\", type number}, {\"EstimateValue\", type number},",
                "        {\"SurpriseAmount\", type number}, {\"SurprisePercent\", type number},",
                "        {\"FiscalYear\", Int64.Type}",
                "    })",
                "in",
                "    typedResult"
              ]
            }
          }
        ]
      },
