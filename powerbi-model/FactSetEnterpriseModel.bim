{
  "name": "FactSet Enterprise Analytics",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DimDate\",\"DimEntity\",\"DimSecurity\",\"DimCurrency\",\"DimBenchmark\",\"FactPrices\",\"FactReturns\",\"FactDividends\",\"FactFundamentals\",\"FactEstimatesConsensus\",\"FactEstimatesSurprise\",\"FactESGScores\",\"FactOwnership\",\"FactBenchmarkConstituents\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "1"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.130.930.0 (24.07)"
      }
    ],
    "dataSources": [
      {
        "type": "structured",
        "name": "FactSet API",
        "connectionDetails": {
          "protocol": "web",
          "address": {
            "url": "https://api.factset.com/content"
          }
        },
        "credential": {
          "AuthenticationKind": "OAuth2",
          "kind": "OAuth2",
          "path": "https://api.factset.com"
        },
        "annotations": [
          {
            "name": "Description",
            "value": "FactSet Content API - OAuth 2.0 client credentials flow. Configure credentials via FactSet Developer Portal: https://developer.factset.com"
          }
        ]
      }
    ],
    "tables": [
      {
        "name": "DimDate",
        "description": "Date dimension table for time-based analysis. Supports daily, weekly, monthly, quarterly, and annual aggregations.",
        "lineageTag": "dim-date-001",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "dim-date-date",
            "summarizeBy": "none",
            "isKey": true,
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" }
            ]
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "lineageTag": "dim-date-year",
            "summarizeBy": "none"
          },
          {
            "name": "Quarter",
            "dataType": "int64",
            "sourceColumn": "Quarter",
            "lineageTag": "dim-date-quarter",
            "summarizeBy": "none"
          },
          {
            "name": "QuarterLabel",
            "dataType": "string",
            "sourceColumn": "QuarterLabel",
            "lineageTag": "dim-date-quarter-label",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "int64",
            "sourceColumn": "Month",
            "lineageTag": "dim-date-month",
            "summarizeBy": "none"
          },
          {
            "name": "MonthName",
            "dataType": "string",
            "sourceColumn": "MonthName",
            "lineageTag": "dim-date-month-name",
            "summarizeBy": "none",
            "sortByColumn": "Month"
          },
          {
            "name": "WeekOfYear",
            "dataType": "int64",
            "sourceColumn": "WeekOfYear",
            "lineageTag": "dim-date-week",
            "summarizeBy": "none"
          },
          {
            "name": "DayOfWeek",
            "dataType": "int64",
            "sourceColumn": "DayOfWeek",
            "lineageTag": "dim-date-dow",
            "summarizeBy": "none"
          },
          {
            "name": "DayName",
            "dataType": "string",
            "sourceColumn": "DayName",
            "lineageTag": "dim-date-day-name",
            "summarizeBy": "none",
            "sortByColumn": "DayOfWeek"
          },
          {
            "name": "IsBusinessDay",
            "dataType": "boolean",
            "sourceColumn": "IsBusinessDay",
            "lineageTag": "dim-date-is-bday",
            "summarizeBy": "none"
          },
          {
            "name": "FiscalYear",
            "dataType": "int64",
            "sourceColumn": "FiscalYear",
            "lineageTag": "dim-date-fy",
            "summarizeBy": "none"
          },
          {
            "name": "FiscalQuarter",
            "dataType": "int64",
            "sourceColumn": "FiscalQuarter",
            "lineageTag": "dim-date-fq",
            "summarizeBy": "none"
          },
          {
            "name": "YearMonth",
            "dataType": "string",
            "sourceColumn": "YearMonth",
            "lineageTag": "dim-date-ym",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimDate-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    StartDate = #date(2010, 1, 1),",
                "    EndDate = Date.From(DateTime.LocalNow()),",
                "    DayCount = Duration.Days(EndDate - StartDate) + 1,",
                "    DateList = List.Dates(StartDate, DayCount, #duration(1, 0, 0, 0)),",
                "    ToTable = Table.FromList(DateList, Splitter.SplitByNothing(), {\"Date\"}, null, ExtraValues.Error),",
                "    ChangedType = Table.TransformColumnTypes(ToTable, {{\"Date\", type date}}),",
                "    AddYear = Table.AddColumn(ChangedType, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    AddQuarter = Table.AddColumn(AddYear, \"Quarter\", each Date.QuarterOfYear([Date]), Int64.Type),",
                "    AddQuarterLabel = Table.AddColumn(AddQuarter, \"QuarterLabel\", each \"Q\" & Text.From(Date.QuarterOfYear([Date])) & \" \" & Text.From(Date.Year([Date])), type text),",
                "    AddMonth = Table.AddColumn(AddQuarterLabel, \"Month\", each Date.Month([Date]), Int64.Type),",
                "    AddMonthName = Table.AddColumn(AddMonth, \"MonthName\", each Date.MonthName([Date]), type text),",
                "    AddWeekOfYear = Table.AddColumn(AddMonthName, \"WeekOfYear\", each Date.WeekOfYear([Date]), Int64.Type),",
                "    AddDayOfWeek = Table.AddColumn(AddWeekOfYear, \"DayOfWeek\", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),",
                "    AddDayName = Table.AddColumn(AddDayOfWeek, \"DayName\", each Date.DayOfWeekName([Date]), type text),",
                "    AddIsBusinessDay = Table.AddColumn(AddDayName, \"IsBusinessDay\", each Date.DayOfWeek([Date], Day.Monday) < 5, type logical),",
                "    AddFiscalYear = Table.AddColumn(AddIsBusinessDay, \"FiscalYear\", each if Date.Month([Date]) >= 7 then Date.Year([Date]) + 1 else Date.Year([Date]), Int64.Type),",
                "    AddFiscalQuarter = Table.AddColumn(AddFiscalYear, \"FiscalQuarter\", each if Date.Month([Date]) >= 7 then Date.QuarterOfYear([Date]) - 2 else Date.QuarterOfYear([Date]) + 2, Int64.Type),",
                "    AddYearMonth = Table.AddColumn(AddFiscalQuarter, \"YearMonth\", each Text.From(Date.Year([Date])) & \"-\" & Text.PadStart(Text.From(Date.Month([Date])), 2, \"0\"), type text)",
                "in",
                "    AddYearMonth"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Calendar Hierarchy",
            "lineageTag": "hier-calendar",
            "levels": [
              { "name": "Year", "ordinal": 0, "column": "Year", "lineageTag": "hier-cal-year" },
              { "name": "Quarter", "ordinal": 1, "column": "QuarterLabel", "lineageTag": "hier-cal-quarter" },
              { "name": "Month", "ordinal": 2, "column": "MonthName", "lineageTag": "hier-cal-month" },
              { "name": "Date", "ordinal": 3, "column": "Date", "lineageTag": "hier-cal-date" }
            ]
          },
          {
            "name": "Fiscal Hierarchy",
            "lineageTag": "hier-fiscal",
            "levels": [
              { "name": "Fiscal Year", "ordinal": 0, "column": "FiscalYear", "lineageTag": "hier-fy" },
              { "name": "Fiscal Quarter", "ordinal": 1, "column": "FiscalQuarter", "lineageTag": "hier-fq" },
              { "name": "Date", "ordinal": 2, "column": "Date", "lineageTag": "hier-fiscal-date" }
            ]
          }
        ]
      },
      {
        "name": "DimEntity",
        "description": "Entity reference data from FactSet Entity API. Contains company profiles, headquarters, and classification data.",
        "lineageTag": "dim-entity-001",
        "columns": [
          {
            "name": "EntityId",
            "dataType": "string",
            "sourceColumn": "EntityId",
            "lineageTag": "dim-entity-id",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "EntityName",
            "dataType": "string",
            "sourceColumn": "EntityName",
            "lineageTag": "dim-entity-name",
            "summarizeBy": "none"
          },
          {
            "name": "UltimateParentId",
            "dataType": "string",
            "sourceColumn": "UltimateParentId",
            "lineageTag": "dim-entity-parent-id",
            "summarizeBy": "none"
          },
          {
            "name": "UltimateParentName",
            "dataType": "string",
            "sourceColumn": "UltimateParentName",
            "lineageTag": "dim-entity-parent-name",
            "summarizeBy": "none"
          },
          {
            "name": "CreditParentId",
            "dataType": "string",
            "sourceColumn": "CreditParentId",
            "lineageTag": "dim-entity-credit-parent",
            "summarizeBy": "none"
          },
          {
            "name": "IsPublic",
            "dataType": "boolean",
            "sourceColumn": "IsPublic",
            "lineageTag": "dim-entity-is-public",
            "summarizeBy": "none"
          },
          {
            "name": "SecurityType",
            "dataType": "string",
            "sourceColumn": "SecurityType",
            "lineageTag": "dim-entity-sec-type",
            "summarizeBy": "none"
          },
          {
            "name": "Website",
            "dataType": "string",
            "sourceColumn": "Website",
            "lineageTag": "dim-entity-website",
            "summarizeBy": "none",
            "dataCategory": "WebUrl"
          },
          {
            "name": "IncorporationDate",
            "dataType": "dateTime",
            "sourceColumn": "IncorporationDate",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "dim-entity-incorp-date",
            "summarizeBy": "none"
          },
          {
            "name": "CountryOfRisk",
            "dataType": "string",
            "sourceColumn": "CountryOfRisk",
            "lineageTag": "dim-entity-country-risk",
            "summarizeBy": "none"
          },
          {
            "name": "IncorporationCountry",
            "dataType": "string",
            "sourceColumn": "IncorporationCountry",
            "lineageTag": "dim-entity-incorp-country",
            "summarizeBy": "none"
          },
          {
            "name": "BusinessDescription",
            "dataType": "string",
            "sourceColumn": "BusinessDescription",
            "lineageTag": "dim-entity-biz-desc",
            "summarizeBy": "none"
          },
          {
            "name": "Phone",
            "dataType": "string",
            "sourceColumn": "Phone",
            "lineageTag": "dim-entity-phone",
            "summarizeBy": "none"
          },
          {
            "name": "HeadquartersCity",
            "dataType": "string",
            "sourceColumn": "HeadquartersCity",
            "lineageTag": "dim-entity-hq-city",
            "summarizeBy": "none",
            "dataCategory": "City"
          },
          {
            "name": "HeadquartersState",
            "dataType": "string",
            "sourceColumn": "HeadquartersState",
            "lineageTag": "dim-entity-hq-state",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince"
          },
          {
            "name": "HeadquartersCountry",
            "dataType": "string",
            "sourceColumn": "HeadquartersCountry",
            "lineageTag": "dim-entity-hq-country",
            "summarizeBy": "none",
            "dataCategory": "Country"
          },
          {
            "name": "HeadquartersZip",
            "dataType": "string",
            "sourceColumn": "HeadquartersZip",
            "lineageTag": "dim-entity-hq-zip",
            "summarizeBy": "none",
            "dataCategory": "PostalCode"
          },
          {
            "name": "EmailIR",
            "dataType": "string",
            "sourceColumn": "EmailIR",
            "lineageTag": "dim-entity-email-ir",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimEntity-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    apiBase = \"https://api.factset.com/content/factset-entity/v1/entity-references\",",
                "    requestBody = Json.FromValue([ids = FactSet_WatchlistIds, #\"type\" = \"security\"]),",
                "    response = Web.Contents(apiBase, [",
                "        Headers = [",
                "            #\"Content-Type\" = \"application/json\",",
                "            #\"Accept\" = \"application/json\",",
                "            #\"Authorization\" = \"Bearer \" & FactSet_AccessToken",
                "        ],",
                "        Content = requestBody",
                "    ]),",
                "    parsed = Json.Document(response),",
                "    data = parsed[data],",
                "    toTable = Table.FromRecords(data),",
                "    renamed = Table.RenameColumns(toTable, {",
                "        {\"fsymId\", \"EntityId\"},",
                "        {\"entityProperName\", \"EntityName\"},",
                "        {\"ultimateParentId\", \"UltimateParentId\"},",
                "        {\"ultimateParentName\", \"UltimateParentName\"},",
                "        {\"creditParentId\", \"CreditParentId\"},",
                "        {\"securityType\", \"SecurityType\"},",
                "        {\"website\", \"Website\"},",
                "        {\"incorporationDate\", \"IncorporationDate\"},",
                "        {\"countryOfRisk\", \"CountryOfRisk\"},",
                "        {\"incorporationCountry\", \"IncorporationCountry\"},",
                "        {\"businessDescription\", \"BusinessDescription\"},",
                "        {\"phone\", \"Phone\"},",
                "        {\"headquartersCity\", \"HeadquartersCity\"},",
                "        {\"headquartersState\", \"HeadquartersState\"},",
                "        {\"headquartersCountry\", \"HeadquartersCountry\"},",
                "        {\"headquartersZip\", \"HeadquartersZip\"},",
                "        {\"emailIR\", \"EmailIR\"}",
                "    }),",
                "    addIsPublic = Table.AddColumn(renamed, \"IsPublic\", each try [publicEntityFlag] = 1 otherwise false, type logical),",
                "    removeRaw = Table.RemoveColumns(addIsPublic, {\"publicEntityFlag\", \"privateEntityFlag\", \"requestId\", \"parentEquityId\", \"fsymEntityId\", \"countryOfRiskGeoRev\", \"websiteIR\", \"headquartersStreet\"}, MissingField.Ignore),",
                "    typedResult = Table.TransformColumnTypes(removeRaw, {",
                "        {\"EntityId\", type text}, {\"EntityName\", type text}, {\"IncorporationDate\", type date},",
                "        {\"CountryOfRisk\", type text}, {\"HeadquartersCountry\", type text}",
                "    })",
                "in",
                "    typedResult"
              ]
            }
          }
        ]
      },
      {
        "name": "DimSecurity",
        "description": "Security-level reference linking securities to entities. Maps FactSet regional IDs (-R) to entity IDs (-E).",
        "lineageTag": "dim-security-001",
        "columns": [
          {
            "name": "FsymId",
            "dataType": "string",
            "sourceColumn": "FsymId",
            "lineageTag": "dim-sec-fsym-id",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "EntityId",
            "dataType": "string",
            "sourceColumn": "EntityId",
            "lineageTag": "dim-sec-entity-id",
            "summarizeBy": "none"
          },
          {
            "name": "SecurityName",
            "dataType": "string",
            "sourceColumn": "SecurityName",
            "lineageTag": "dim-sec-name",
            "summarizeBy": "none"
          },
          {
            "name": "Ticker",
            "dataType": "string",
            "sourceColumn": "Ticker",
            "lineageTag": "dim-sec-ticker",
            "summarizeBy": "none"
          },
          {
            "name": "Exchange",
            "dataType": "string",
            "sourceColumn": "Exchange",
            "lineageTag": "dim-sec-exchange",
            "summarizeBy": "none"
          },
          {
            "name": "SecurityType",
            "dataType": "string",
            "sourceColumn": "SecurityType",
            "lineageTag": "dim-sec-type",
            "summarizeBy": "none"
          },
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "lineageTag": "dim-sec-currency",
            "summarizeBy": "none"
          },
          {
            "name": "Country",
            "dataType": "string",
            "sourceColumn": "Country",
            "lineageTag": "dim-sec-country",
            "summarizeBy": "none",
            "dataCategory": "Country"
          },
          {
            "name": "ActiveFlag",
            "dataType": "boolean",
            "sourceColumn": "ActiveFlag",
            "lineageTag": "dim-sec-active",
            "summarizeBy": "none"
          },
          {
            "name": "ListingDate",
            "dataType": "dateTime",
            "sourceColumn": "ListingDate",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "dim-sec-listing-date",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimSecurity-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    apiBase = \"https://api.factset.com/content/factset-entity/v1/entity-securities\",",
                "    requestBody = Json.FromValue([ids = FactSet_WatchlistIds]),",
                "    response = Web.Contents(apiBase, [",
                "        Headers = [",
                "            #\"Content-Type\" = \"application/json\",",
                "            #\"Accept\" = \"application/json\",",
                "            #\"Authorization\" = \"Bearer \" & FactSet_AccessToken",
                "        ],",
                "        Content = requestBody",
                "    ]),",
                "    parsed = Json.Document(response),",
                "    data = parsed[data],",
                "    toTable = Table.FromRecords(data),",
                "    renamed = Table.RenameColumns(toTable, {",
                "        {\"fsymId\", \"FsymId\"},",
                "        {\"fsymEntityId\", \"EntityId\"},",
                "        {\"securityName\", \"SecurityName\"},",
                "        {\"localTicker\", \"Ticker\"},",
                "        {\"exchange\", \"Exchange\"},",
                "        {\"securityType\", \"SecurityType\"},",
                "        {\"tradingCurrency\", \"Currency\"},",
                "        {\"country\", \"Country\"},",
                "        {\"activeFlag\", \"ActiveFlag\"},",
                "        {\"listingDate\", \"ListingDate\"}",
                "    }, MissingField.Ignore),",
                "    typedResult = Table.TransformColumnTypes(renamed, {",
                "        {\"FsymId\", type text}, {\"EntityId\", type text}, {\"Ticker\", type text},",
                "        {\"ListingDate\", type date}, {\"ActiveFlag\", type logical}",
                "    })",
                "in",
                "    typedResult"
              ]
            }
          }
        ]
      },
      {
        "name": "DimCurrency",
        "description": "Currency reference table for multi-currency reporting.",
        "lineageTag": "dim-currency-001",
        "columns": [
          {
            "name": "CurrencyCode",
            "dataType": "string",
            "sourceColumn": "CurrencyCode",
            "lineageTag": "dim-curr-code",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "CurrencyName",
            "dataType": "string",
            "sourceColumn": "CurrencyName",
            "lineageTag": "dim-curr-name",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimCurrency-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    currencies = Table.FromRows({",
                "        {\"USD\", \"US Dollar\"}, {\"EUR\", \"Euro\"}, {\"GBP\", \"British Pound\"},",
                "        {\"JPY\", \"Japanese Yen\"}, {\"CHF\", \"Swiss Franc\"}, {\"CAD\", \"Canadian Dollar\"},",
                "        {\"AUD\", \"Australian Dollar\"}, {\"CNY\", \"Chinese Yuan\"}, {\"HKD\", \"Hong Kong Dollar\"},",
                "        {\"SGD\", \"Singapore Dollar\"}, {\"KRW\", \"South Korean Won\"}, {\"INR\", \"Indian Rupee\"},",
                "        {\"BRL\", \"Brazilian Real\"}, {\"MXN\", \"Mexican Peso\"}, {\"SEK\", \"Swedish Krona\"},",
                "        {\"NOK\", \"Norwegian Krone\"}, {\"DKK\", \"Danish Krone\"}, {\"NZD\", \"New Zealand Dollar\"},",
                "        {\"ZAR\", \"South African Rand\"}, {\"TWD\", \"Taiwan Dollar\"}",
                "    }, {\"CurrencyCode\", \"CurrencyName\"}),",
                "    typedResult = Table.TransformColumnTypes(currencies, {{\"CurrencyCode\", type text}, {\"CurrencyName\", type text}})",
                "in",
                "    typedResult"
              ]
            }
          }
        ]
      },
      {
        "name": "DimBenchmark",
