                "        {\"FsymId\", type text}, {\"Date\", type date},",
                "        {\"SharesHeld\", type number}, {\"MarketValue\", type number},",
                "        {\"PercentOutstanding\", type number}, {\"PositionChange\", type number}",
                "    })",
                "in",
                "    typedResult"
              ]
            }
          }
        ]
      },
