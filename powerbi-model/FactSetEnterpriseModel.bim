      {
        "name": "_Measures",
        "description": "Centralized measures table containing all DAX calculations for the model.",
        "lineageTag": "measures-table-001",
        "columns": [],
        "partitions": [
          {
            "name": "_Measures-Partition",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"MeasureSpace\", BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Latest Close Price",
            "expression": "VAR _lastDate = MAX(FactPrices[Date]) RETURN CALCULATE(SELECTEDVALUE(FactPrices[ClosePrice]), FactPrices[Date] = _lastDate)",
            "formatString": "#,##0.00",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-latest-close",
            "annotations": [{ "name": "Description", "value": "Most recent closing price for the selected security." }]
          },
          {
            "name": "Period High",
            "expression": "MAX(FactPrices[HighPrice])",
            "formatString": "#,##0.00",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-period-high"
          },
          {
            "name": "Period Low",
            "expression": "MIN(FactPrices[LowPrice])",
            "formatString": "#,##0.00",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-period-low"
          },
          {
            "name": "Avg Daily Volume",
            "expression": "AVERAGE(FactPrices[Volume])",
            "formatString": "#,##0",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-avg-volume"
          },
          {
            "name": "Total Volume",
            "expression": "SUM(FactPrices[Volume])",
            "formatString": "#,##0",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-total-volume"
          },
          {
            "name": "VWAP",
            "expression": "DIVIDE(SUMX(FactPrices, FactPrices[ClosePrice] * FactPrices[Volume]), SUM(FactPrices[Volume]), BLANK())",
            "formatString": "#,##0.00",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-vwap",
            "annotations": [{ "name": "Description", "value": "Volume-Weighted Average Price over the selected period." }]
          },
          {
            "name": "Price Range",
            "expression": "[Period High] - [Period Low]",
            "formatString": "#,##0.00",
            "displayFolder": "Price Metrics",
            "lineageTag": "m-price-range"
          },
          {
            "name": "Daily Return %",
            "expression": "VAR _lastDate = MAX(FactPrices[Date]) VAR _prevDate = CALCULATE(MAX(FactPrices[Date]), FactPrices[Date] < _lastDate) VAR _lastClose = CALCULATE(SELECTEDVALUE(FactPrices[ClosePrice]), FactPrices[Date] = _lastDate) VAR _prevClose = CALCULATE(SELECTEDVALUE(FactPrices[ClosePrice]), FactPrices[Date] = _prevDate) RETURN DIVIDE(_lastClose - _prevClose, _prevClose, BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Return Metrics",
            "lineageTag": "m-daily-return"
          },
          {
            "name": "Cumulative Total Return",
            "expression": "PRODUCTX(FactReturns, 1 + FactReturns[TotalReturn]) - 1",
            "formatString": "0.00%",
            "displayFolder": "Return Metrics",
            "lineageTag": "m-cum-total-return",
            "annotations": [{ "name": "Description", "value": "Compound total return over the selected period, including dividends." }]
          },
          {
            "name": "Annualized Return",
            "expression": "VAR _cumReturn = [Cumulative Total Return] VAR _dayCount = COUNTROWS(FactReturns) VAR _years = DIVIDE(_dayCount, 12) RETURN IF(_years > 0, POWER(1 + _cumReturn, DIVIDE(1, _years)) - 1, BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Return Metrics",
            "lineageTag": "m-ann-return"
          },
          {
            "name": "Return Volatility",
            "expression": "VAR _avgReturn = AVERAGEX(FactReturns, FactReturns[TotalReturn]) VAR _variance = AVERAGEX(FactReturns, POWER(FactReturns[TotalReturn] - _avgReturn, 2)) RETURN SQRT(_variance) * SQRT(12)",
            "formatString": "0.00%",
            "displayFolder": "Return Metrics",
            "lineageTag": "m-volatility",
            "annotations": [{ "name": "Description", "value": "Annualized volatility of monthly returns (standard deviation * sqrt(12))." }]
          },
          {
            "name": "Sharpe Ratio",
            "expression": "VAR _annReturn = [Annualized Return] VAR _vol = [Return Volatility] VAR _riskFreeRate = 0.05 RETURN DIVIDE(_annReturn - _riskFreeRate, _vol, BLANK())",
            "formatString": "#,##0.00",
            "displayFolder": "Return Metrics",
            "lineageTag": "m-sharpe",
            "annotations": [{ "name": "Description", "value": "Sharpe ratio using 5% risk-free rate assumption. Adjust FactSet_RiskFreeRate parameter as needed." }]
          },
          {
            "name": "Revenue (Latest)",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_SALES\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Income Statement",
            "lineageTag": "m-revenue"
          },
          {
            "name": "Net Income (Latest)",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_NET_INC\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Income Statement",
            "lineageTag": "m-net-income"
          },
          {
            "name": "EBITDA (Latest)",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_EBITDA\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Income Statement",
            "lineageTag": "m-ebitda"
          },
          {
            "name": "EPS (Latest)",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_EPS\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0.00",
            "displayFolder": "Fundamental Metrics\\Per Share",
            "lineageTag": "m-eps"
          },
          {
            "name": "Book Value Per Share",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_BPS\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0.00",
            "displayFolder": "Fundamental Metrics\\Per Share",
            "lineageTag": "m-bvps"
          },
          {
            "name": "Dividends Per Share",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_DIV_PS\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0.00",
            "displayFolder": "Fundamental Metrics\\Per Share",
            "lineageTag": "m-dps"
          },
          {
            "name": "Market Cap",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_MKT_VAL\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Valuation",
            "lineageTag": "m-market-cap"
          },
          {
            "name": "Enterprise Value",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_ENTRPR_VAL\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Valuation",
            "lineageTag": "m-ev"
          },
          {
            "name": "P/E Ratio",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_PE\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0.0x",
            "displayFolder": "Fundamental Metrics\\Valuation",
            "lineageTag": "m-pe-ratio"
          },
          {
            "name": "P/B Ratio",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_PBK\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0.0x",
            "displayFolder": "Fundamental Metrics\\Valuation",
            "lineageTag": "m-pb-ratio"
          },
          {
            "name": "EV/EBITDA",
            "expression": "DIVIDE([Enterprise Value], [EBITDA (Latest)], BLANK())",
            "formatString": "#,##0.0x",
            "displayFolder": "Fundamental Metrics\\Valuation",
            "lineageTag": "m-ev-ebitda"
          },
          {
            "name": "Dividend Yield",
            "expression": "DIVIDE([Dividends Per Share], [Latest Close Price], BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Valuation",
            "lineageTag": "m-div-yield"
          },
          {
            "name": "Gross Margin",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_GROSS_MGN\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Profitability",
            "lineageTag": "m-gross-margin"
          },
          {
            "name": "Operating Margin",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_OPER_MGN\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Profitability",
            "lineageTag": "m-oper-margin"
          },
          {
            "name": "Net Margin",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_NET_MGN\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Profitability",
            "lineageTag": "m-net-margin"
          },
          {
            "name": "ROE",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_ROE\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Profitability",
            "lineageTag": "m-roe"
          },
          {
            "name": "ROA",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_ROA\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Profitability",
            "lineageTag": "m-roa"
          },
          {
            "name": "Total Assets",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_ASSETS\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Balance Sheet",
            "lineageTag": "m-total-assets"
          },
          {
            "name": "Total Equity",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_EQY_TOT\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Balance Sheet",
            "lineageTag": "m-total-equity"
          },
          {
            "name": "Long-Term Debt",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_DEBT_LT\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Balance Sheet",
            "lineageTag": "m-lt-debt"
          },
          {
            "name": "Debt-to-Equity",
            "expression": "VAR _totalDebt = CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_DEBT_LT\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1)) + CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_DEBT_ST\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1)) RETURN DIVIDE(_totalDebt, [Total Equity], BLANK())",
            "formatString": "#,##0.00",
            "displayFolder": "Fundamental Metrics\\Balance Sheet",
            "lineageTag": "m-debt-equity"
          },
          {
            "name": "Free Cash Flow",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_FREE_CF\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Cash Flow",
            "lineageTag": "m-fcf"
          },
          {
            "name": "Operating Cash Flow",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_OPER_CF\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Cash Flow",
            "lineageTag": "m-oper-cf"
          },
          {
            "name": "CapEx",
            "expression": "CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_CAP_EX\", LASTNONBLANK(FactFundamentals[FiscalEndDate], 1))",
            "formatString": "#,##0",
            "displayFolder": "Fundamental Metrics\\Cash Flow",
            "lineageTag": "m-capex"
          },
          {
            "name": "FCF Yield",
            "expression": "DIVIDE([Free Cash Flow], [Market Cap], BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Fundamental Metrics\\Cash Flow",
            "lineageTag": "m-fcf-yield"
          },
          {
            "name": "Revenue YoY Growth",
            "expression": "VAR _currentYear = MAX(FactFundamentals[FiscalYear]) VAR _currentRev = CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_SALES\", FactFundamentals[FiscalYear] = _currentYear) VAR _priorRev = CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_SALES\", FactFundamentals[FiscalYear] = _currentYear - 1) RETURN DIVIDE(_currentRev - _priorRev, ABS(_priorRev), BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Growth Metrics",
            "lineageTag": "m-rev-growth"
          },
          {
            "name": "EPS YoY Growth",
            "expression": "VAR _currentYear = MAX(FactFundamentals[FiscalYear]) VAR _currentEPS = CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_EPS\", FactFundamentals[FiscalYear] = _currentYear) VAR _priorEPS = CALCULATE(SUM(FactFundamentals[Value]), FactFundamentals[Metric] = \"FF_EPS\", FactFundamentals[FiscalYear] = _currentYear - 1) RETURN DIVIDE(_currentEPS - _priorEPS, ABS(_priorEPS), BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Growth Metrics",
            "lineageTag": "m-eps-growth"
          },
          {
            "name": "Consensus EPS (NTM)",
            "expression": "CALCULATE(SELECTEDVALUE(FactEstimatesConsensus[ConsensusMean]), FactEstimatesConsensus[Metric] = \"EPS\", LASTNONBLANK(FactEstimatesConsensus[Date], 1))",
            "formatString": "#,##0.00",
            "displayFolder": "Estimates",
            "lineageTag": "m-consensus-eps"
          },
          {
            "name": "Consensus Revenue (NTM)",
            "expression": "CALCULATE(SELECTEDVALUE(FactEstimatesConsensus[ConsensusMean]), FactEstimatesConsensus[Metric] = \"SALES\", LASTNONBLANK(FactEstimatesConsensus[Date], 1))",
            "formatString": "#,##0",
            "displayFolder": "Estimates",
            "lineageTag": "m-consensus-rev"
          },
          {
            "name": "Forward P/E",
            "expression": "DIVIDE([Latest Close Price], [Consensus EPS (NTM)], BLANK())",
            "formatString": "#,##0.0x",
            "displayFolder": "Estimates",
            "lineageTag": "m-fwd-pe",
            "annotations": [{ "name": "Description", "value": "Forward P/E ratio using NTM consensus EPS estimate." }]
          },
          {
            "name": "Estimate Spread (EPS)",
            "expression": "VAR _latest = LASTNONBLANK(FactEstimatesConsensus[Date], 1) RETURN CALCULATE(SELECTEDVALUE(FactEstimatesConsensus[ConsensusHigh]) - SELECTEDVALUE(FactEstimatesConsensus[ConsensusLow]), FactEstimatesConsensus[Metric] = \"EPS\", FactEstimatesConsensus[Date] = _latest)",
            "formatString": "#,##0.00",
            "displayFolder": "Estimates",
            "lineageTag": "m-est-spread"
          },
          {
            "name": "Analyst Count",
            "expression": "CALCULATE(SELECTEDVALUE(FactEstimatesConsensus[EstimateCount]), FactEstimatesConsensus[Metric] = \"EPS\", LASTNONBLANK(FactEstimatesConsensus[Date], 1))",
            "formatString": "#,##0",
            "displayFolder": "Estimates",
            "lineageTag": "m-analyst-count"
          },
          {
            "name": "EPS Beat Rate",
            "expression": "DIVIDE(COUNTROWS(FILTER(FactEstimatesSurprise, FactEstimatesSurprise[Metric] = \"EPS\" && FactEstimatesSurprise[SurpriseAmount] > 0)), COUNTROWS(FILTER(FactEstimatesSurprise, FactEstimatesSurprise[Metric] = \"EPS\")), BLANK())",
            "formatString": "0.0%",
            "displayFolder": "Estimates\\Surprise",
            "lineageTag": "m-eps-beat-rate",
            "annotations": [{ "name": "Description", "value": "Percentage of quarters where actual EPS exceeded consensus estimate." }]
          },
          {
            "name": "Avg EPS Surprise %",
            "expression": "CALCULATE(AVERAGE(FactEstimatesSurprise[SurprisePercent]), FactEstimatesSurprise[Metric] = \"EPS\")",
            "formatString": "0.00%",
            "displayFolder": "Estimates\\Surprise",
            "lineageTag": "m-avg-eps-surprise"
          },
          {
            "name": "Last EPS Surprise",
            "expression": "VAR _lastDate = CALCULATE(MAX(FactEstimatesSurprise[Date]), FactEstimatesSurprise[Metric] = \"EPS\") RETURN CALCULATE(SELECTEDVALUE(FactEstimatesSurprise[SurpriseAmount]), FactEstimatesSurprise[Metric] = \"EPS\", FactEstimatesSurprise[Date] = _lastDate)",
            "formatString": "#,##0.00",
            "displayFolder": "Estimates\\Surprise",
            "lineageTag": "m-last-eps-surprise"
          },
          {
            "name": "ESG Score (Latest)",
            "expression": "CALCULATE(SELECTEDVALUE(FactESGScores[ESGScore]), LASTNONBLANK(FactESGScores[Date], 1))",
            "formatString": "#,##0.0",
            "displayFolder": "ESG",
            "lineageTag": "m-esg-score"
          },
          {
            "name": "Environmental Score",
            "expression": "CALCULATE(SELECTEDVALUE(FactESGScores[EnvironmentalScore]), LASTNONBLANK(FactESGScores[Date], 1))",
            "formatString": "#,##0.0",
            "displayFolder": "ESG",
            "lineageTag": "m-env-score"
          },
          {
            "name": "Social Score",
            "expression": "CALCULATE(SELECTEDVALUE(FactESGScores[SocialScore]), LASTNONBLANK(FactESGScores[Date], 1))",
            "formatString": "#,##0.0",
            "displayFolder": "ESG",
            "lineageTag": "m-social-score"
          },
          {
            "name": "Governance Score",
            "expression": "CALCULATE(SELECTEDVALUE(FactESGScores[GovernanceScore]), LASTNONBLANK(FactESGScores[Date], 1))",
            "formatString": "#,##0.0",
            "displayFolder": "ESG",
            "lineageTag": "m-gov-score"
          },
          {
            "name": "ESG Percentile Rank",
            "expression": "CALCULATE(SELECTEDVALUE(FactESGScores[ESGRankPercent]), LASTNONBLANK(FactESGScores[Date], 1))",
            "formatString": "0.0%",
            "displayFolder": "ESG",
            "lineageTag": "m-esg-pct-rank"
          },
          {
            "name": "Institutional Ownership %",
            "expression": "SUM(FactOwnership[PercentOutstanding])",
            "formatString": "0.00%",
            "displayFolder": "Ownership",
            "lineageTag": "m-inst-own-pct"
          },
          {
            "name": "Holder Count",
            "expression": "DISTINCTCOUNT(FactOwnership[HolderEntityId])",
            "formatString": "#,##0",
            "displayFolder": "Ownership",
            "lineageTag": "m-holder-count"
          },
          {
            "name": "Top 10 Holder Concentration",
            "expression": "VAR _ranked = TOPN(10, VALUES(FactOwnership[HolderEntityId]), CALCULATE(SUM(FactOwnership[PercentOutstanding])), DESC) RETURN SUMX(_ranked, CALCULATE(SUM(FactOwnership[PercentOutstanding])))",
            "formatString": "0.00%",
            "displayFolder": "Ownership",
            "lineageTag": "m-top10-concentration",
            "annotations": [{ "name": "Description", "value": "Combined ownership percentage of the top 10 institutional holders." }]
          },
          {
            "name": "Total Dividends Paid",
            "expression": "SUM(FactDividends[DividendAmount])",
            "formatString": "#,##0.0000",
            "displayFolder": "Dividends",
            "lineageTag": "m-total-divs"
          },
          {
            "name": "Dividend Count",
            "expression": "COUNTROWS(FactDividends)",
            "formatString": "#,##0",
            "displayFolder": "Dividends",
            "lineageTag": "m-div-count"
          },
          {
            "name": "Annual Dividend",
            "expression": "CALCULATE(SUM(FactDividends[DividendAmount]), DATESINPERIOD(DimDate[Date], MAX(DimDate[Date]), -1, YEAR))",
            "formatString": "#,##0.00",
            "displayFolder": "Dividends",
            "lineageTag": "m-annual-div"
          },
          {
            "name": "Benchmark Weight",
            "expression": "SUM(FactBenchmarkConstituents[Weight])",
            "formatString": "0.00%",
            "displayFolder": "Benchmark",
            "lineageTag": "m-bench-weight"
          },
          {
            "name": "Active Weight",
            "expression": "[Benchmark Weight] - DIVIDE(1, COUNTROWS(FactBenchmarkConstituents), BLANK())",
            "formatString": "0.00%",
            "displayFolder": "Benchmark",
            "lineageTag": "m-active-weight",
            "annotations": [{ "name": "Description", "value": "Weight relative to equal-weight benchmark. Positive = overweight." }]
          },
          {
            "name": "Security Count",
            "expression": "DISTINCTCOUNT(DimSecurity[FsymId])",
            "formatString": "#,##0",
            "displayFolder": "Portfolio",
            "lineageTag": "m-sec-count"
          },
          {
            "name": "Entity Count",
            "expression": "DISTINCTCOUNT(DimEntity[EntityId])",
            "formatString": "#,##0",
            "displayFolder": "Portfolio",
            "lineageTag": "m-entity-count"
          }
        ]
      }
    ],
